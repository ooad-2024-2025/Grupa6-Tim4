@model IEnumerable<BloomBox.Models.Proizvod>

@{
    ViewData["Title"] = "Katalog";
    bool isAdminOrWorker = User.IsInRole("Administrator") || User.IsInRole("Radnik");
}

<p>
    @if (isAdminOrWorker)
    {
        <a asp-action="Create" class="btn btn-sm" style="background-color: #4CAF50; color: white;">Dodaj novi artikal</a>
    }
</p>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            @if (isAdminOrWorker)
            {
                <div class="card h-100 shadow-sm">
                    <img src="@item.slikaURL" class="card-img-top" style="object-fit: cover; height: 200px;" alt="Slika proizvoda">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.ime</h5>
                        <p class="card-text">Cijena: @item.cijena KM</p>
                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@item.proizvodId" class="custom-button">Detalji</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@item.proizvodId" class="product-link">
                    <div class="product-card">
                        <img src="@item.slikaURL" alt="Slika" class="product-image" />
                        <div class="product-name">@item.ime</div>
                        <div>@item.cijena KM</div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .custom-button {
            background-color: #1c1418;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.3s, color 0.3s;
        }

            .custom-button:hover {
                background-color: #3a2b31;
                color: #f0f0f0;
            }

        .product-link {
            text-decoration: none;
            color: inherit;
        }

        .product-card {
            border: 1px solid #ccc;
            padding: 15px;
            background-color: #f9f9f9;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .product-card:hover {
                transform: scale(1.02);
                box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.2);
            }

        .product-image {
            aspect-ratio: 1 / 1;
            width: 100%;
            object-fit: cover;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .product-name {
            font-weight: bold;
            font-size: 1.2em;
            margin-bottom: 5px;
        }

        .btn-close {
            background: transparent;
            border: none;
            opacity: 0.6;
            transition: opacity 0.2s ease;
        }

            .btn-close:hover {
                opacity: 1;
            }

        .no-radius {
            border-radius: 0px !important;
        }

    </style>
}
