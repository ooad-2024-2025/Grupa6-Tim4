@model IEnumerable<BloomBox.Models.ProizvodKorpa>

@{
    ViewData["Title"] = "Stanje svih korpi";
}

    <h1>Pregled korpi</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Kupac</th>
                <th>Proizvod</th>
                <th>Količina</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Kupac != null ? item.Kupac.UserName : "Gost")</td>
                    <td>@item.Proizvod.ime</td>
                    <td>@item.kolicina</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.proizvodKorpaId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.proizvodKorpaId" class="btn btn-sm btn-danger">Delete</a>
                        <a asp-controller="Proizvod" asp-action="Details" asp-route-id="@item.proizvodId" class="btn btn-sm btn-info">Detalji</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
