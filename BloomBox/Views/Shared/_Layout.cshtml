<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BloomBox</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BloomBox.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false) <!--stavljeno kako bi svaki view imao svoj css-->
    <style>
        body {
            background-color: #ffdddd;
            color: black
        }
    </style>
</head>
<body>
    <!-- ovaj header ce se naci na svakom linku tjst pri svakoj navigaciji-->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BloomBox</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Proizvod" asp-action="Index">Katalog</a>
                        </li>
                        @if (!(User.IsInRole("Administrator") || User.IsInRole("Radnik")))
                        {
                            <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="ProizvodKorpa" asp-action="Index">Korpa</a>
                        </li>
                        }
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Lokacija" asp-action="Index">Lokacije poslovnica</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Parametri" asp-action="Index">Kviz</a>
                        </li>
                        @if (User.IsInRole("Administrator") || User.IsInRole("Radnik"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" style="color: #b30000;" asp-controller="Narudzba" asp-action="Index">Narudžbe</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" style="color: #b30000;" asp-controller="ProizvodKorpa" asp-action="Index">Korpe</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <style>
        body {
            background-color: #fcf3f4;
            color: black;
        }

        header .navbar {
            background-color: #f6dbdd;
        }
    </style>

    <!-- fja renderbody() bira koja stranica ce se prikazati-->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BloomBox - <a asp-area="" asp-controller="Home" asp-action="Index">Pocetna</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

